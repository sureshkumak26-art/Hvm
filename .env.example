# Copy this file to .env on the server; never commit the real .env.
PANEL_NAME=Anime Cloud Panel
SECRET_KEY=replace-with-a-long-random-secret
PANEL_API_BASE=http://127.0.0.1:5000/api/v1
PANEL_API_KEY=replace-with-a-newly-rotated-panel-api-key
DISCORD_TOKEN=
# Comma-separated numeric Discord user IDs authorized for administration.
ADMIN_USER_IDS=

# Authenticated HVM-Panel node agent. Prefer loopback/private network or HTTPS.
NODE_AGENT_URL=http://127.0.0.1:8787
NODE_AGENT_TOKEN=replace-with-the-same-long-random-token-as-HVM_NODE_TOKEN
# Numeric Discord text channel ID for mining security alerts.
MINING_ALERT_CHANNEL_ID=0
MINING_SCAN_INTERVAL_SECONDS=120
